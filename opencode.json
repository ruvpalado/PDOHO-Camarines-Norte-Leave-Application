{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "video-gen": {
      "type": "local",
      "command": ["uv", "--directory", "/home/rvpal/mcp-video-gen", "run", "--extra", "gcp", "video-gen"],
      "environment": {
        "GEMINI_API_KEY": "{env:GEMINI_API_KEY}",
        "GCP_PROJECT_ID": "{env:GCP_PROJECT_ID}",
        "VEO_MODEL": "veo-3.1-fast-generate-001",
        "VIDEO_OUTPUT_DIR": "/home/rvpal/mcp-video-gen/output"
      },
      "enabled": true
    }
  }
}